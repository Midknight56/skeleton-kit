@@ -0,0 +1,81 @@
+import fc from 'fast-check';
+import { describe, expect, it } from 'vitest';
+import sampleHop from '../test-fixtures/sample-hop/def';
+import sampleLights from '../test-fixtures/sample-lights/def';
+import { countFirstMoves, solveTurn } from './turn';
+
+const LEVELS = ['l1', 'l2', 'l3'] as const;
+
+function decided(level: (typeof LEVELS)[number], options: Parameters<typeof countFirstMoves>[3] = {}) {
+  const result = countFirstMoves(sampleLights, level, 1, options);
+  expect(result.decided).toBe(true);
+  if (!result.decided) throw new Error('first move count was undecided');
+  return result.firstMoves;
+}
+
+describe('countFirstMoves', () => {
+  it('counts legal and winning first moves at the shortest depth', () => {
+    expect(decided('l1', { maxDepth: 1 })).toEqual({ legal: 9, winning: 1 });
+    expect(decided('l2', { maxDepth: 2 })).toEqual({ legal: 9, winning: 2 });
+    expect(decided('l3', { maxDepth: 3 })).toEqual({ legal: 9, winning: 3 });
+  });
+
+  it('counts no moves when allow refuses every action', () => {
+    expect(decided('l1', { allow: () => false })).toEqual({ legal: 0, winning: 0 });
+  });
+
+  it('reports a node limit for an undecided first action search', () => {
+    expect(countFirstMoves(sampleLights, 'l3', 1, { maxNodes: 10 })).toEqual({ decided: false, reason: 'node_limit', action: 'press:0,0' });
+  });
+
+  it('returns zero counts for a start state that is already won', () => {
+    const won = { ...sampleLights, init: () => ({ lamps: new Array<number>(9).fill(0), moves: 0 }) };
+    expect(countFirstMoves(won, 'l1', 1)).toEqual({ decided: true, firstMoves: { legal: 0, winning: 0 } });
+  });
+
+  it('rejects a tick game with a plain error', () => {
+    expect(() => countFirstMoves(sampleHop, 'h1', 1)).toThrowError(/^countFirstMoves needs a turn game/);
+    try {
+      countFirstMoves(sampleHop, 'h1', 1);
+    } catch (error) {
+      expect(error).toBeInstanceOf(Error);
+      return;
+    }
+    throw new Error('expected countFirstMoves to throw');
+  });
+
+  it('counts a solution first action among the winning moves', () => {
+    const expectedFirst: Record<string, string> = {
+      l1: 'press:1,1',
+      l2: 'press:0,0',
+      l3: 'press:1,0',
+    };
+    for (const level of LEVELS) {
+      const solved = solveTurn(sampleLights, level, 1);
+      expect(solved.solved).toBe(true);
+      if (!solved.solved) continue;
+      expect(solved.actions[0]).toBe(expectedFirst[level]);
+      expect(decided(level, { maxDepth: solved.actions.length }).winning).toBeGreaterThanOrEqual(1);
+    }
+  });
+
+  it('has bounded winning counts and includes a solution when solveTurn solves', () => {
+    fc.assert(
+      fc.property(fc.constantFrom(...LEVELS), fc.integer({ min: 1, max: 5 }), (level, maxDepth) => {
+        const result = countFirstMoves(sampleLights, level, 1, { maxDepth });
+        if (!result.decided) return;
+        expect(result.firstMoves.winning).toBeLessThanOrEqual(result.firstMoves.legal);
+        const solved = solveTurn(sampleLights, level, 1, { maxDepth });
+        if (solved.solved) expect(result.firstMoves.winning).toBeGreaterThanOrEqual(1);
+      }),
+    );
+  });
+
+  it('returns the same result on repeated calls', () => {
+    fc.assert(
+      fc.property(fc.constantFrom(...LEVELS), fc.integer({ min: 1, max: 5 }), (level, maxDepth) => {
+        expect(countFirstMoves(sampleLights, level, 1, { maxDepth })).toEqual(countFirstMoves(sampleLights, level, 1, { maxDepth }));
+      }),
+    );
+  });
+});
