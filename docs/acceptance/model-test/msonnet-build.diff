@@ -0,0 +1,138 @@
+import fc from 'fast-check';
+import { describe, expect, it } from 'vitest';
+import { canonicalJson } from '@kit/core';
+import sampleHop from '../test-fixtures/sample-hop/def';
+import sampleLights, { type LightsAction, type LightsState } from '../test-fixtures/sample-lights/def';
+import { countFirstMoves, solveTurn, type FirstMovesResult } from './turn';
+
+const LEVELS = ['l1', 'l2', 'l3'] as const;
+
+function decided(result: FirstMovesResult): { legal: number; winning: number } {
+  if (!result.decided) throw new Error(`undecided: ${result.reason} at ${result.action}`);
+  return result.firstMoves;
+}
+
+describe('countFirstMoves on the lights sample', () => {
+  it('counts the presses of the solution when maxDepth equals the shortest length', () => {
+    expect(decided(countFirstMoves(sampleLights, 'l1', 1, { maxDepth: 1 }))).toEqual({ legal: 9, winning: 1 });
+    expect(decided(countFirstMoves(sampleLights, 'l2', 1, { maxDepth: 2 }))).toEqual({ legal: 9, winning: 2 });
+    expect(decided(countFirstMoves(sampleLights, 'l3', 1, { maxDepth: 3 }))).toEqual({ legal: 9, winning: 3 });
+  });
+
+  it('gives legal 0 and winning 0 when allow refuses every action', () => {
+    expect(decided(countFirstMoves(sampleLights, 'l2', 1, { allow: () => false }))).toEqual({ legal: 0, winning: 0 });
+  });
+
+  it('counts only the actions that allow accepts', () => {
+    const only = decided(
+      countFirstMoves(sampleLights, 'l2', 1, { maxDepth: 2, allow: (text) => text === 'press:0,0' || text === 'press:2,2' || text === 'press:1,1' }),
+    );
+    expect(only).toEqual({ legal: 3, winning: 2 });
+  });
+
+  it('gives undecided with node_limit and the first action that hit it when maxNodes 10 is too small for l3', () => {
+    expect(countFirstMoves(sampleLights, 'l3', 1, { maxNodes: 10 })).toEqual({ decided: false, reason: 'node_limit', action: 'press:0,0' });
+  });
+
+  it('counts depth_limit and exhausted as not winning, not as undecided', () => {
+    expect(decided(countFirstMoves(sampleLights, 'l3', 1, { maxDepth: 2 }))).toEqual({ legal: 9, winning: 0 });
+    expect(decided(countFirstMoves(sampleLights, 'l3', 1, { allow: (text) => text === 'press:0,0' }))).toEqual({ legal: 1, winning: 0 });
+  });
+
+  it('gives winning 0 when maxDepth is 0, because no action fits', () => {
+    expect(decided(countFirstMoves(sampleLights, 'l1', 1, { maxDepth: 0 }))).toEqual({ legal: 9, winning: 0 });
+  });
+
+  it('returns legal 0 and winning 0 when the start state is already won', () => {
+    const won = { ...sampleLights, init: () => ({ lamps: new Array<number>(9).fill(0), moves: 0 }) };
+    expect(decided(countFirstMoves(won, 'l1', 1))).toEqual({ legal: 0, winning: 0 });
+  });
+
+  it('counts two first actions that reach the same state both', () => {
+    const same = { ...sampleLights, step: (state: LightsState) => ({ lamps: new Array<number>(9).fill(0), moves: state.moves + 1 }) };
+    expect(decided(countFirstMoves(same, 'l1', 1))).toEqual({ legal: 9, winning: 9 });
+  });
+
+  it('does not hide a path that goes back through the start state', () => {
+    // The first action press:0,0 leads to a middle state. From there the only way to win is to go back to the
+    // start state and take press:1,0. A visited set that held the start state would miss that win.
+    type S = { at: string };
+    const loop = {
+      ...sampleLights,
+      init: (): S => ({ at: 'start' }),
+      actions: (state: S): LightsAction[] => {
+        if (state.at === 'won') return [];
+        if (state.at === 'start') return [{ x: 0, y: 0 }, { x: 1, y: 0 }];
+        return [{ x: 2, y: 0 }];
+      },
+      step: (state: S, action: LightsAction): S => {
+        if (state.at === 'start') return action.x === 0 ? { at: 'middle' } : { at: 'won' };
+        return { at: 'start' };
+      },
+      status: (state: S) => (state.at === 'won' ? { phase: 'won' as const, score: 0 } : { phase: 'playing' as const, score: 0 }),
+    };
+    // press:0,0 goes to the middle, back to the start, then press:1,0 wins. That is 3 actions in total.
+    expect(decided(countFirstMoves(loop as never, 'l1', 1, { maxDepth: 3 }))).toEqual({ legal: 2, winning: 2 });
+    expect(decided(countFirstMoves(loop as never, 'l1', 1, { maxDepth: 2 }))).toEqual({ legal: 2, winning: 1 });
+  });
+
+  it('gives the same answer for the same start and does not change with the options object', () => {
+    expect(countFirstMoves(sampleLights, 'l3', 1)).toEqual(countFirstMoves(sampleLights, 'l3', 1, {}));
+  });
+
+  it('throws a plain Error for a tick game', () => {
+    let caught: unknown = null;
+    try {
+      countFirstMoves(sampleHop, 'h1', 1);
+    } catch (error) {
+      caught = error;
+    }
+    expect(caught).toBeInstanceOf(Error);
+    expect(Object.getPrototypeOf(caught)).toBe(Error.prototype);
+    expect((caught as Error).message.startsWith('countFirstMoves needs a turn game')).toBe(true);
+  });
+});
+
+describe('countFirstMoves properties', () => {
+  const level = fc.constantFrom(...LEVELS);
+  const depth = fc.integer({ min: 1, max: 5 });
+
+  it('winning is at most legal, and at least 1 when solveTurn solves the level with the same maxDepth', () => {
+    fc.assert(
+      fc.property(level, depth, (levelId, maxDepth) => {
+        const { legal, winning } = decided(countFirstMoves(sampleLights, levelId, 1, { maxDepth }));
+        expect(winning).toBeLessThanOrEqual(legal);
+        if (solveTurn(sampleLights, levelId, 1, { maxDepth }).solved) expect(winning).toBeGreaterThanOrEqual(1);
+      }),
+      { numRuns: 30 },
+    );
+  });
+
+  it('the first action of the solveTurn result is among the winning first moves', () => {
+    fc.assert(
+      fc.property(level, depth, (levelId, maxDepth) => {
+        const solved = solveTurn(sampleLights, levelId, 1, { maxDepth });
+        if (!solved.solved) return;
+        const first = solved.actions[0] as string;
+        // A copy of the game that lists only that first action at the start state.
+        const start = canonicalJson(sampleLights.init(levelId, 1));
+        const narrowed = {
+          ...sampleLights,
+          actions: (state: LightsState) =>
+            canonicalJson(state) === start ? sampleLights.actions(state).filter((action) => sampleLights.encodeAction(action) === first) : sampleLights.actions(state),
+        };
+        expect(decided(countFirstMoves(narrowed, levelId, 1, { maxDepth }))).toEqual({ legal: 1, winning: 1 });
+      }),
+      { numRuns: 30 },
+    );
+  });
+
+  it('two calls with the same input give equal results', () => {
+    fc.assert(
+      fc.property(level, depth, (levelId, maxDepth) => {
+        expect(countFirstMoves(sampleLights, levelId, 1, { maxDepth })).toEqual(countFirstMoves(sampleLights, levelId, 1, { maxDepth }));
+      }),
+      { numRuns: 30 },
+    );
+  });
+});
