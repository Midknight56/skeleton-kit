+/**
+ * Counts the first actions of a turn level and how many of them can still win. It runs the same search as the proof,
+ * with the same options, once for each legal first action. A first action wins when that search finds a solution.
+ * Returns a reason when a search stops at the node limit, because the count would then be wrong.
+ */
+function countFirstMoves(game: Game, levelId: string): FirstMoves | string {
+  const { def } = game;
+  const allow = game.turnOptions?.allow ?? (() => true);
+  const start = createSession(def, levelId, SEED).state;
+  if (def.status(start).phase !== 'playing') return { legal: 0, winning: 0 };
+  const texts = [...new Set(def.actions(start).map((action) => def.encodeAction(action)).filter((text) => allow(text)))];
+  let winning = 0;
+  for (const text of texts) {
+    const result = solveTurn(def, levelId, SEED, { ...game.turnOptions, firstMove: text });
+    if (result.solved) winning++;
+    else if (result.reason === 'node_limit') return `first move ${text}: the search stopped at the node limit after ${result.nodes} nodes`;
+  }
+  return { legal: texts.length, winning };
+}
