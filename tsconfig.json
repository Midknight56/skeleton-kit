{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["tools/**/*.ts", "kit/**/*.ts", "apps/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
